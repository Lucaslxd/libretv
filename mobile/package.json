{
  "name": "libretv-mobile",
  "version": "1.0.0",
  "private": true,
  "description": "LibreTV 多平台外壳（Capacitor：Android / iOS）",
  "scripts": {
    "copy": "node copy-web.js",
    "add:android": "cap add android",
    "add:ios": "cap add ios",
    "sync": "node copy-web.js && cap sync",
    "sync:android": "node copy-web.js && cap sync android",
    "sync:ios": "node copy-web.js && cap sync ios",
    "open:android": "cap open android",
    "open:ios": "cap open ios",
    "run:android": "node copy-web.js && cap run android",
    "run:ios": "node copy-web.js && cap run ios",
    "doctor": "cap doctor"
  },
  "dependencies": {
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/ios": "^7.0.0",
    "@capacitor/splash-screen": "^7.0.0",
    "@capacitor/status-bar": "^7.0.0",
    "ltbridge-proxy": "file:plugins/ltproxy"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "typescript": "^5.7.2"
  }
}
